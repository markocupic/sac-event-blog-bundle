{
    "name": "markocupic/sac-event-blog-bundle",
    "description": "Manage event blogs in the Contao backend and display them in the frontend of your website.",
    "keywords": [
        "SAC",
        "Swiss Alpine Club",
        "Contao",
        "event",
        "blog"
    ],
    "type": "contao-bundle",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Marko Cupic",
            "email": "m.cupic@gmx.ch",
            "homepage": "https://github.com/markocupic/event-blog-bundle",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/markocupic/sac-event-blog-bundle/issues",
        "source": "https://github.com/markocupic/sac-event-blog-bundle"
    },
    "require": {
        "php": "^8.4",
        "ext-iconv": "*",
        "contao/core-bundle": "^5.3 || ^6.0",
        "chillerlan/php-qrcode": "^5.0",
        "codefog/contao-haste": "^5.0",
        "markocupic/contao-component-vue-js": "^3.3",
        "markocupic/contao-twig-assets": "^1.0",
        "markocupic/phpoffice-bundle": "^1.3",
        "markocupic/sac-event-tool-bundle": "dev-contao5 || dev-contao6",
        "markocupic/zip-bundle": "^1.1",
        "terminal42/notification_center": "^2.0",
        "markocupic/contao-filepond-uploader": "^1.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.12",
        "contao/test-case": "^5.3 || ^6.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Markocupic\\SacEventBlogBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markocupic\\SacEventBlogBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Markocupic\\SacEventBlogBundle\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "php-http/discovery": false,
            "composer/package-versions-deprecated": true,
            "contao-community-alliance/composer-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "markocupic/composer-file-copier-plugin": false
        }
    },
    "scripts": {
        "cs-fixer": "@php tools/ecs/vendor/bin/ecs check --config tools/ecs/config/default.php --fix --ansi",
        "cs-check": "@php tools/ecs/vendor/bin/ecs check --config tools/ecs/config/default.php --ansi",
        "phpstan": "@php tools/phpstan/vendor/bin/phpstan analyse src tests",
        "unit-tests": "@php vendor/bin/phpunit --colors=always"
    }
}
