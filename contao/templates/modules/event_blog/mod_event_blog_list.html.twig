{% use "@Contao/component/_headline.html.twig" %}

<!-- indexer::stop -->
{% if not isAjaxRequest %}
    {% do addJavascriptResource(asset('js/event_blog_list_vue.js', 'markocupic_sac_event_blog')) %}
    {% do addHtmlToBody('<script src="'~asset('vue/dist/vue.global.prod.js', 'markocupic_sac_event_blog')~'"></script>') %}

    <div class="{{ class }} block" {{ cssID }}{% if style is defined %} style="{{ style }}"{% endif %}>

        {% block headline_component %}
            {% set headline = {
                text: headline,
                tag_name: hl,
            } %}
            {{ parent() }}
        {% endblock %}

        <div id="eventBlogList{{ id }}">
            <div class=" list-container" v-html="listContent"></div>
            <!-- start modal -->
            <div class="modal" class="event-blog-reader-modal" tabindex="-1" role="dialog" aria-labelledby="eventBlogReaderModalTitle{{ id }}" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-fullscreen-xl-down" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="eventBlogReaderModalTitle{{ id }}">Tourenberichte</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schliessen"></button>
                        </div>
                        <div class="modal-body px-3 px-sm-4 px-lg-5">
                            <div class="d-flex justify-content-between justify-content-md-end">
                                <button type="button" v-if="hasPrevItem()" v-on:click="goToPrevItem()" class="btn btn-primary ms-0"><i class="fa-solid fa-arrow-left"></i> Vorheriger Bericht</button>
                                <button type="button" v-if="hasNextItem()" v-on:click="goToNextItem()" class="btn btn-primary ms-2">Nächster Bericht <i class="fa-solid fa-arrow-right"></i></button>
                            </div>
                            <div class="mt-5" v-html="readerContent"></div>
                        </div>
                        <div class="modal-footer d-none d-sm-block">{# Do not show the footer on mobile phones #}
                            <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Schliessen</button>
                        </div>
                    </div>
                </div>
            </div>
            <!-- end modal -->
        </div>
    </div>

    <script{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
        document.addEventListener('DOMContentLoaded', function () {
            // Instantiate ItemWatcher class
            new EventBlogList('#eventBlogList{{ id }}', {
                'params': {
                    'listModuleId': '{{ id }}',
                    'apiKey': '{{ eventBlogApiKey|default('') }}',
                    'readerModuleId': '{{ eventBlogReaderModule|default('') }}',
                    'perPage': '{{ perPage }}',
                    'itemIds': [{{ arrBlogIds|join(',') }}],
                    'language': '{{ language }}',
                }
            });
        }, false);
    </script>
{% endif %}

{% if isAjaxRequest %}
    <div class="grid-card equal-height block">
        {% for blog in blogs %}
            <div itemscope itemtype="http://schema.org/Article">
                <div class="card event-item bg-white">
                    <div class="image-zoom-in">
                        <a href="{{ blog.href }}" class="item-reader-link" aria-label="{{ blog.title|escape('html_attr') }}">
                            {% if blog.singleSRC|default and blog.singleSRC.uuid|default %}
                                {{ insert_tag('image::' ~ blog.singleSRC.uuid ~ '?width=450&height=300&mode=crop&class=card-img-top')|raw }}
                            {% else %}
                                {% set placeholder_image = asset('images/news_default_image.svg','markocupic_sac_event_blog') %}
                                <img src="{{ placeholder_image }}" width="450" height="300"/>
                                {{ insert_tag('image::' ~ placeholder_image ~ '?width=450&height=300&class=card-img-top')|raw }}
                            {% endif %}
                        </a>
                    </div>
                    <div class="card-body bg-white p-3">
                        <a href="{{ blog.href }}" title="weiterlesen" class="text-decoration-none item-reader-link">
                            <h6 class="card-title mt-0">{{ substr(blog.title,55) }}</h6>
                        </a>
                        <p class="card-news-teaser mb-0">{{ substr(blog.text,80)|raw }}</p>
                    </div>
                    <div class="card-footer border-top-0 bg-white p-3">
                        <div class="d-flex align-items-center">
                            {{ insert_tag('image::' ~ getAvatarResourcePath(blog.author.model ?? null) ~ '?width=40&height=40&mode=crop&class=rounded-circle')|raw }}
                            {# Respect privacy and do not show the author name, if an author (frontend user) has deleted his account #}
                            {% set author_name = blog.author.name ?? 'Unbekannt' %}
                            <div class="d-flex flex-column ps-3">
                                <p class="card-text m-0 fw-bold"><small>{{ author_name }}</small></p>
                                <p class="card-date text-muted m-0">
                                    <small>
                                        <time datetime="{{ blog.dateAdded|date('Y-m-d\TH:i:sP') }}">
                                            {{ blog.dateAdded|date('d.m.Y') }}
                                        </time>
                                    </small>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
    {{ pagination|raw }}
{% endif %}
<!-- indexer::continue -->
