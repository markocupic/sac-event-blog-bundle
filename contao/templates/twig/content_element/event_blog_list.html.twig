{% extends "@Contao/content_element/_base.html.twig" %}

{% set searchable = false %}

{% block wrapper %}
    {% if htmx_fragment|default(false) %}
        {# HTMX request from the pagination: only return the list items and the pagination #}
        {{ block('event_blog_list_items') }}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block content %}
    {% do addJavascriptResource(asset('htmx/htmx.min.js', 'markocupic_sac_event_blog')) %}
    {% do addJavascriptResource(asset('js/event_blog_list.js', 'markocupic_sac_event_blog')) %}

    <div id="{{ htmx_target }}" class="event-blog-list">
        {{ block('event_blog_list_items') }}
    </div>

    <!-- start modal -->
    <div class="modal event-blog-reader-modal" tabindex="-1" role="dialog" aria-labelledby="eventBlogReaderModalTitle{{ data.id }}" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-fullscreen-xl-down" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="eventBlogReaderModalTitle{{ data.id }}">Tourenberichte</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schliessen"></button>
                </div>
                {# The reader is loaded into this element with HTMX #}
                <div class="modal-body px-3 px-sm-4 px-lg-5" id="{{ reader_target }}"></div>
                <div class="modal-footer d-none d-sm-block">{# Do not show the footer on mobile phones #}
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Schliessen</button>
                </div>
            </div>
        </div>
    </div>
    <!-- end modal -->
{% endblock %}

{% block event_blog_list_items %}
    {# The reader is loaded with HTMX into the modal window (see EventBlogReaderController) #}
    <div class="grid-card equal-height block" hx-target="#{{ reader_target }}" hx-sync="#{{ reader_target }}:replace" hx-push-url="false">
        {% for blog in blogs %}
            <div itemscope itemtype="http://schema.org/Article">
                <div class="card event-item bg-white">
                    <div class="image-zoom-in">
                        <a href="{{ blog.href }}"{% if blog.href %} hx-get="{{ blog.href }}"{% endif %} class="item-reader-link" aria-label="{{ blog.title|escape('html_attr') }}">
                            {% if blog.singleSRC|default and blog.singleSRC.uuid|default %}
                                {{ insert_tag('image::' ~ blog.singleSRC.uuid ~ '?width=450&height=300&mode=crop&class=card-img-top')|raw }}
                            {% else %}
                                {% set placeholder_image = asset('images/news_default_image.svg','markocupic_sac_event_blog') %}
                                <img src="{{ placeholder_image }}" width="450" height="300" class="card-img-top" alt="" loading="lazy">
                            {% endif %}
                        </a>
                    </div>
                    <div class="card-body bg-white p-3">
                        <a href="{{ blog.href }}"{% if blog.href %} hx-get="{{ blog.href }}"{% endif %} title="weiterlesen" class="text-decoration-none item-reader-link">
                            <h6 class="card-title mt-0">{{ substr(blog.title,55) }}</h6>
                        </a>
                        <p class="card-news-teaser mb-0">{{ substr(blog.text,80)|raw }}</p>
                    </div>
                    <div class="card-footer border-top-0 bg-white p-3">
                        <div class="d-flex align-items-center">
                            {{ insert_tag('image::' ~ getAvatarResourcePath(blog.author.model ?? null) ~ '?width=40&height=40&mode=crop&class=rounded-circle')|raw }}
                            {# Respect privacy and do not show the author name, if an author (frontend user) has deleted his account #}
                            {% set author_name = blog.author.name ?? 'Unbekannt' %}
                            <div class="d-flex flex-column ps-3">
                                <p class="card-text m-0 fw-bold"><small>{{ author_name }}</small></p>
                                <p class="card-date text-muted m-0">
                                    <small>
                                        <time datetime="{{ blog.dateAdded|date('Y-m-d\TH:i:sP') }}">
                                            {{ blog.dateAdded|date('d.m.Y') }}
                                        </time>
                                    </small>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
    {% if pagination|default %}
        {# The pagination links are loaded with HTMX into the list container (see EventBlogListController) #}
        <div class="event-blog-list-pagination" hx-boost="true" hx-target="#{{ htmx_target }}" hx-swap="innerHTML show:#{{ htmx_target }}:top" hx-sync="#{{ htmx_target }}:replace">
            {{ pagination|raw }}
        </div>
    {% endif %}
{% endblock %}
