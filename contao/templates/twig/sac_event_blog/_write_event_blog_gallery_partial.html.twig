{% if images is defined and not images is empty %}
    <br>
    <hr>

    {% if publishState is constant('\\Markocupic\\SacEventBlogBundle\\Config\\PublishState::STILL_IN_PROGRESS') %}
        <p><i class="fa-solid fa-info-circle"></i> Bildreihenfolge kann durch Drag-and-Drop verändert werden.</p>
    {% endif %}

    <div id="dashboardEventBlogGallery" class="{% if publishState is constant('\\Markocupic\\SacEventBlogBundle\\Config\\PublishState::STILL_IN_PROGRESS') %}sortable-thumbnail-container {% endif %} dashboard-event-blog-gallery row gx-2 gy-1">
        {% for arrFile in images %}
            {% set counter = ( counter | default(-1) ) + 1 %}

            <div class="col-12 col-sm-6 col-md-3 thumbnail {% if publishState is constant('\\Markocupic\\SacEventBlogBundle\\Config\\PublishState::STILL_IN_PROGRESS') %}sortable-item {% endif %}responsive" data-item="{{ counter }}" data-path="{{ arrFile.path }}" data-file-id="{{ arrFile.id }}" data-file-uuid="{{ binToUuid.invoke(arrFile.uuid) }}" title="Sortierung mit Drag-and-Drop ändern">
                {{ insert_tag('image::' ~ binToUuid.invoke(arrFile.uuid) ~ '?width=400&height=400&mode=crop&class=w-100 img-fluid')|raw }}

                <div class="d-none">{{ arrFile.caption }}</div>
                {% if publishState is constant('\\Markocupic\\SacEventBlogBundle\\Config\\PublishState::STILL_IN_PROGRESS') %}
                    <div class="dashboard-event-blog-thumb-buttons-container d-flex">
                        {% if arrFile.caption is empty or arrFile.photographer is empty %}
                            <button class="btn blinking missing-caption-or-photographer-name add-caption" title="Fehlende Bildlegende oder Name des Fotografen fehlt"><i class="fa-solid fa-exclamation-circle"></i></button>
                        {% endif %}
                        <button class="btn btn-danger rotate-image" title="Bild im GUZ 90° drehen"><i class="fa-solid fa-history"></i></button>
                        <button class="btn btn-danger remove-image" title="Bild löschen"><i class="fa-solid fa-trash"></i></button>
                        <button class="btn btn-danger add-caption" title="Bildunterschrift und Fotografen-Name hinzufügen"><i class="fa-solid fa-pencil"></i></button>
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
    <!-- End gallery -->


    {% if publishState is constant('\\Markocupic\\SacEventBlogBundle\\Config\\PublishState::STILL_IN_PROGRESS') %}
        {% add to body %}
            <script>
                document.addEventListener("DOMContentLoaded", () => {
                    // Open modal for caption edit
                    const captionButtons = document.querySelectorAll('button.add-caption');

                    for (const button of captionButtons) {
                        button.addEventListener("click", async () => {
                            const thumbnail = button.closest('.thumbnail');
                            const path = thumbnail.getAttribute('data-path');
                            const item = thumbnail.getAttribute('data-item');
                            const fileUuid = thumbnail.getAttribute('data-file-uuid');
                            const modal = document.querySelector('.modal.write-event-blog-image-caption');

                            if (modal) {
                                const imageFullRes = modal.querySelector('.image-full-res');
                                if (imageFullRes) {
                                    imageFullRes.setAttribute('src', path);
                                }

                                modal.setAttribute('data-item', item);

                                // Get caption text via the fetch API
                                try {
                                    const response = await fetch('ajaxMemberDashboardWriteEventBlog/getCaption', {
                                        method: 'POST',
                                        headers: {
                                            'Content-Type': 'application/x-www-form-urlencoded',
                                            'X-Requested-With': 'XMLHttpRequest',
                                        },
                                        body: `REQUEST_TOKEN={{ request_token }}&fileUuid=${fileUuid}`
                                    });

                                    const json = await response.json();

                                    if (json.status !== 'success') {
                                        console.log(json);
                                    } else {
                                        // Open Bootstrap modal window
                                        const bsModal = new bootstrap.Modal(modal);
                                        bsModal.show();

                                        const imageCaptionInput = modal.querySelector('#imageCaptionInput');
                                        const imagePhotographerInput = modal.querySelector('#imagePhotographerInput');

                                        if (imageCaptionInput) {
                                            imageCaptionInput.value = json.caption;
                                        }

                                        if (imagePhotographerInput) {
                                            imagePhotographerInput.value = json.photographer;
                                        }
                                    }
                                } catch (error) {
                                    console.error("Error fetching caption:", error);
                                }
                            }
                        });
                    }

                    // Save caption to the server
                    const saveButtons = document.querySelectorAll('.modal.write-event-blog-image-caption button#saveCaptionButton');

                    for (const saveButton of saveButtons) {
                        saveButton.addEventListener("click", async () => {
                            const modal = saveButton.closest('.modal.write-event-blog-image-caption');

                            if (modal) {
                                // Close Bootstrap modal window
                                const bsModal = new bootstrap.Modal(modal);
                                bsModal.hide();

                                const caption = modal.querySelector('#imageCaptionInput')?.value || '';
                                const photographer = modal.querySelector('#imagePhotographerInput')?.value || '';
                                const item = modal.getAttribute('data-item');
                                const thumbnail = document.querySelector(`#dashboardEventBlogGallery .thumbnail[data-item="${item}"]`);

                                if (thumbnail) {
                                    thumbnail.setAttribute('data-caption', caption);
                                    const fileUuid = thumbnail.getAttribute('data-file-uuid');

                                    // Save caption via the fetch API
                                    try {
                                        const response = await fetch('ajaxMemberDashboardWriteEventBlog/setCaption', {
                                            method: 'POST',
                                            headers: {
                                                'Content-Type': 'application/x-www-form-urlencoded',
                                                'X-Requested-With': 'XMLHttpRequest',
                                            },
                                            body: `REQUEST_TOKEN={{ request_token }}&fileUuid=${fileUuid}&caption=${caption}&photographer=${photographer}`
                                        });

                                        const json = await response.json();

                                        if (json.status !== 'success') {
                                            console.log(json);
                                        }
                                    } catch (error) {
                                        console.error("Error saving caption:", error);
                                    } finally {
                                        window.location.reload();
                                    }
                                }
                            }
                        });
                    }
                });
            </script>

        {% endadd %}
    {% endif %}


    {% if publishState is constant('\\Markocupic\\SacEventBlogBundle\\Config\\PublishState::STILL_IN_PROGRESS') %}
        {% add to head %}
            <script src="{{ asset('sortablejs/Sortable.min.js', 'markocupic_sac_event_blog') }}"></script>
        {% endadd %}
        {% add to body %}
            <script>
                "use strict";

                document.addEventListener("DOMContentLoaded", () => {
                    /**
                     * Remove image from collection
                     */
                    const removeImageButtons = document.querySelectorAll('.remove-image');

                    for (const button of removeImageButtons) {
                        button.addEventListener("click", async (e) => {
                            e.preventDefault();
                            const elImage = button.closest('[data-file-uuid]');
                            if (elImage) {
                                const uuid = elImage.getAttribute('data-file-uuid');
                                if (uuid) {
                                    try {
                                        const response = await fetch('ajaxMemberDashboardWriteEventBlog/removeImage', {
                                            method: 'POST',
                                            headers: {
                                                'Content-Type': 'application/x-www-form-urlencoded',
                                                'X-Requested-With': 'XMLHttpRequest',
                                            },
                                            body: `REQUEST_TOKEN={{ request_token }}&eventId={{ eventId }}&uuid=${uuid}`
                                        });

                                        const json = await response.json();
                                        if (json.status !== 'success') {
                                            console.log(json);
                                        } else {
                                            elImage.style.transition = 'opacity 0.4s';
                                            elImage.style.opacity = '0';
                                            setTimeout(() => elImage.remove(), 400);
                                        }
                                    } catch (error) {
                                        console.error("Error removing image:", error);
                                    }
                                }
                            }
                        });
                    }

                    /**
                     * Rotate image
                     */
                    const rotateImageButtons = document.querySelectorAll('.rotate-image');

                    for (const button of rotateImageButtons) {
                        button.addEventListener("click", async (e) => {
                            e.preventDefault();
                            const elImage = button.closest('[data-file-id]');
                            if (elImage) {
                                const fileId = elImage.getAttribute('data-file-id');
                                if (fileId) {
                                    try {
                                        const response = await fetch('ajaxMemberDashboardWriteEventBlog/rotateImage', {
                                            method: 'POST',
                                            headers: {
                                                'Content-Type': 'application/x-www-form-urlencoded',
                                                'X-Requested-With': 'XMLHttpRequest',
                                            },
                                            body: `REQUEST_TOKEN={{ request_token }}&fileId=${fileId}`
                                        });

                                        const json = await response.json();
                                        if (json.status !== 'success') {
                                            console.log(json);
                                        } else {
                                            window.location.reload();
                                        }
                                    } catch (error) {
                                        console.error("Error rotating image:", error);
                                    }
                                }
                            }
                        });
                    }

                    /**
                     * Image drag-and-drop sorting
                     */
                    const container = document.getElementById("dashboardEventBlogGallery");

                    if (container) {
                        Sortable.create(container, {
                            animation: 50, // Animation speed in milliseconds
                            draggable: ".sortable-item", // Specifies sortable items
                            onUpdate: async (event) => {
                                const item = event.item; // Current dragged element
                                const arrUuid = [];
                                const collection = item.closest('.sortable-thumbnail-container')
                                    ?.querySelectorAll('.sortable-item');
                                if (collection) {
                                    for (const elem of collection) {
                                        arrUuid.push(elem.getAttribute('data-file-uuid'));
                                    }
                                }

                                try {
                                    const response = await fetch('ajaxMemberDashboardWriteEventBlog/sortGallery', {
                                        method: 'POST',
                                        headers: {
                                            'Content-Type': 'application/x-www-form-urlencoded',
                                            'X-Requested-With': 'XMLHttpRequest',
                                        },
                                        body: `REQUEST_TOKEN={{ request_token }}&eventId={{ eventId }}&uuids=${JSON.stringify(arrUuid)}`
                                    });

                                    const json = await response.json();
                                    if (json.status !== 'success') {
                                        console.log(json);
                                    }
                                } catch (error) {
                                    console.error("Error sorting gallery:", error);
                                }
                            }
                        });
                    }
                });
            </script>
        {% endadd %}
    {% endif %}
{% endif %}
