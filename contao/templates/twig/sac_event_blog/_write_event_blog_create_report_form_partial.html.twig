{% do addJavascriptResource(insert_tag('asset::vue/dist/vue.global.prod.js::markocupic_sac_event_blog')) %}

<!-- Modal Box text and YouTube -->
<div id="ModalWriteTextAndYt" class="modal fade write-event-blog-text-and-yt" tabindex="-1" role="dialog" aria-labelledby="ModalWriteTextAndYt"
     aria-hidden="true">
    <div class="modal-dialog modal-xl modal-fullscreen-xl-down" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Bericht erstellen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schliessen"></button>
            </div>
            <div class="modal-body">
                <div id="editReportFormBox">
                    {{ objEventBlogTextAndYoutubeForm|raw }}
                    {# Template for the character limit indicator #}
                    <p class="character-limit-indicator-box template text-success small mt-0 d-none">
                        Verbleibende Zeichen (Leerzeichen inklusive): <span class="character-limit-indicator">{# Will contain the remaining number of available bay characters. #}</span>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<script{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
    document.addEventListener('DOMContentLoaded', () => {
        // protected scope
        const {createApp} = Vue

        const app = createApp({
            data() {
                return {
                    charLimitIndicators: {},
                };
            },

            mounted() {
                const widgets = document.querySelectorAll('#editReportFormBox [data-character-limit-indicator]');

                for (const widget of widgets) {
                    this.charLimitIndicators[widget.id] = {
                        id: widget.id,
                        value: widget.value,
                        len: widget.value.length,
                        remaining: parseInt(widget.getAttribute('data-character-limit-indicator')) - widget.value.length,
                    }

                    const cloneElement = document.querySelector('#editReportFormBox .character-limit-indicator-box.template').cloneNode(true);
                    const charIndicatorElement = widget.insertAdjacentElement('afterend', cloneElement);
                    charIndicatorElement.setAttribute('data-character-indicator-for', widget.id);
                    charIndicatorElement.classList.remove('d-none', 'template');
                    charIndicatorElement.querySelector('.character-limit-indicator').textContent = this.getCharLimitIndicatorRemaining(widget.id);

                    widget.addEventListener('keyup', (e) => {
                        const widget = e.target;
                        this.charLimitIndicators[widget.id].len = widget.value.length;
                        this.charLimitIndicators[widget.id].remaining = parseInt(widget.getAttribute('data-character-limit-indicator')) - widget.value.length;
                        widget.parentElement.querySelector('.character-limit-indicator').textContent = this.getCharLimitIndicatorRemaining(widget.id);
                    });
                }
            },

            methods: {
                getCharLimitIndicator(id) {
                    return this.charLimitIndicators[id];
                },
                getCharLimitIndicatorRemaining(id) {
                    return this.charLimitIndicators[id].remaining;
                },
                getCharLimitIndicatorLen(id) {
                    return this.charLimitIndicators[id].len;
                }
            }
        });

        app.config.compilerOptions.delimiters = ['[[ ', ' ]]'];
        app.mount('#editReportFormBox');
    });
</script>

<script{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
    // Open modal on error
    window.addEventListener("DOMContentLoaded", () => {
        if (document.querySelectorAll('#ModalWriteTextAndYt .widget.error').length) {
            let modal = new bootstrap.Modal(document.getElementById('ModalWriteTextAndYt'));
            modal.show();
        }
    });
</script>
