<div class="modal fade" id="ModalFotoupload" tabindex="-1" role="dialog" aria-labelledby="ModalUploadFoto" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen-xl-down modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Fotoupload</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schliessen"></button>
            </div>
            <div class="modal-body">
                <div>
                    <p class="mt-0"><strong>Bitte beachte ...</strong></p>
                    <ul class="mt-0 list-bullet">
                        <li>Alle (erkennbaren) Personen auf den Bildern musst du vor deiner Publikation um Erlaubnis gefragt haben.</li>
                        <li>Du musst das Urheberrecht der Bilder für die Veröffentlichung haben.</li>
                        <li>Die maximal mögliche Dateigrösse für Bilduploads von <strong>{{ (maxImageFileSize/1000000)|round(1, 'floor') }} MB</strong>.</li>
                        <li>Falls deine Bilder die maximale Auflösung von <strong>{{ maxImageWidth }}x{{ maxImageWidth }} Pixeln</strong> überschreiten, werden diese automatisch verkleinert.</li>
                    </ul>
                </div>
                {{ objEventBlogImageUploadForm|raw }}
            </div>
        </div>
    </div>
</div>
<script{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
    // Prevent the submit while the upload is in progress.
    document.querySelector('#ModalFotoupload form').addEventListener('submit', (event) => {
        if (event.currentTarget.querySelector('.filepond-wrapper.filepond--is-busy')) {
            event.preventDefault();
            alert('Bitte warte mit dem Absenden, bis der Bildupload beendet ist.');
            window.setTimeout(() => {
                // Re-enable the submit button, because the Contao form_wrapper template
                // contains a script that prevent multiple form submits
                document.getElementById('ctrl_submitImageUploadFormBtn').removeAttribute('disabled');
            }, 200);
        } else {
            document.getElementById('ctrl_submitImageUploadFormBtn').disabled = true;
        }
    });
</script>
